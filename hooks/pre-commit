#!/bin/sh
# recall write-time gate.
#
# Asks for the supersession edge while the author still knows the answer. `recall lint --fix`
# measured 60 prose closure markers in a real corpus and could safely declare ZERO of them after
# the fact — narrating vs declaring, part vs whole, augmenting vs replacing are invisible to a
# pattern and obvious to the person writing. This is the moment that person is still here.
#
# Install:  ln -s ../../hooks/pre-commit .git/hooks/pre-commit
# Bypass:   git commit --no-verify   (an augmenting memo is not a successor)

exec python - <<'PY'
import os
from pathlib import Path
import subprocess
from tempfile import TemporaryDirectory

from recall.check import check_file, corpus_names, format_prompt

paths = subprocess.check_output([
    "git", "diff", "--cached", "--name-only", "--diff-filter=ACMRT", "-z",
]).split(b"\0")
needs = 0
with TemporaryDirectory(prefix="recall-staged-") as directory:
    for raw in paths:
        name = os.fsdecode(raw)
        if not name.endswith(".md"):
            continue
        # The index is the commit's content; an unstaged edit must not change its verdict.
        staged = Path(directory) / Path(name).name
        staged.write_bytes(subprocess.check_output(["git", "show", f":./{name}"]))
        result = check_file(staged, corpus_names(Path(name).parent))
        if result.needs_attention:
            needs += 1
            print(format_prompt(result))
if needs:
    print(f"\n{needs} memo(s) state a closure in prose only.")
raise SystemExit(bool(needs))
PY
