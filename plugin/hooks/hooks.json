{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": ["session-start"],
            "timeout": 15,
            "statusMessage": "Recalling project memory"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": ["pre-compact"],
            "async": true,
            "statusMessage": "Saving memory before compaction"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|BashOutput",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": ["pre-tool-use"],
            "timeout": 5,
            "statusMessage": "Searching project memory before the write"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": ["session-end"],
            "async": true,
            "statusMessage": "Indexing session into recall"
          }
        ]
      }
    ]
  }
}
