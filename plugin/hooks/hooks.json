{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": [
              "session-start"
            ],
            "timeout": 15,
            "statusMessage": "Recalling project memory"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": [
              "pre-tool-use"
            ],
            "timeout": 5,
            "statusMessage": "Checking memory before writing"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": [
              "user-prompt-submit"
            ],
            "timeout": 10,
            "statusMessage": "Searching project memory"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": [
              "pre-compact"
            ],
            "async": true,
            "statusMessage": "Saving memory before compaction"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|resume|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "recall-hooks",
            "args": [
              "session-end"
            ],
            "async": true,
            "statusMessage": "Indexing session into recall"
          }
        ]
      }
    ]
  }
}
