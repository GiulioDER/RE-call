  "cards": [
    {
      "dot": "cyan",
      "title": "Pin and certify",
      "items": [
        "The whole search runs against one generation, read once from the tenant state",
        "The threshold comes from that generation's published calibration",
        "A different embedder than the one that built the generation voids the threshold"
      ]
    },
    {
      "dot": "orange",
      "title": "Refuse, abstain, answer",
      "items": [
        "Refuse: under strict trust, an uncertified or mismatched generation is never searched",
        "Abstain: retrieval ran but no hit earned verdict ok, so the reason is returned",
        "Answer: ok hits first, then superseded or expired ones, each with provenance"
      ]
    },
    {
      "dot": "emerald",
      "title": "Retrieve",
      "items": [
        "The query is embedded once, as a query rather than a passage",
        "Dense cosine and Postgres full text each return candidates from the pinned generation",
        "Reciprocal rank fusion merges the two lists; a reranker is opt in"
      ]
    }
  ]
