+    def _iter_item_traces(self, items):
+        """Yield (1-based index, item, trace) in item order.
+
+        workers=1 preserves the original strictly sequential behaviour. With workers > 1,
+        items run on a thread pool with ONE ADAPTER PER WORKER (adapters are taken from and
+        returned to a queue around each item, never shared between two in-flight items), and
+        results are yielded in submission order. Per-item semantics are unchanged: each item
+        still runs reset -> ingest -> recall -> answer -> judge against a single adapter.
+        """
+        if self.workers <= 1 or not self.extra_adapters:
+            for i, item in enumerate(items, 1):
+                yield i, item, self._run_item(item)
+            return
+
+        import queue as _queue
+        from concurrent.futures import ThreadPoolExecutor
+
+        for extra in self.extra_adapters:
+            extra.setup()
+        adapter_pool: "_queue.Queue" = _queue.Queue()
+        adapter_pool.put(self.adapter)
+        for extra in self.extra_adapters:
+            adapter_pool.put(extra)
+
+        def run_one(indexed):
+            i, item = indexed
+            adapter = adapter_pool.get()
+            try:
+                return i, item, self._run_item(item, adapter=adapter)
+            finally:
+                adapter_pool.put(adapter)
+
+        pool_size = min(self.workers, 1 + len(self.extra_adapters))
+        with ThreadPoolExecutor(max_workers=pool_size) as executor:
+            yield from executor.map(run_one, enumerate(items, 1))
+
