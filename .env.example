# Copy to .env for local use. Full explanations live in docs/ENVIRONMENT.md.
# Keep .env private. It is gitignored and read only by local entry points via recall/_env.py.

# Optional cloud embedder for evaluation rows. Local FastEmbed workflows do not need a key.
VOYAGE_API_KEY=

# Core runtime
# RECALL_ENV=development
# RECALL_SERVING_DSN=postgresql://recall_server:...@localhost:5432/recall
# RECALL_MIGRATION_DSN=postgresql://recall_migrator:...@localhost:5432/recall
# RECALL_DSN=postgresql://recall:recall@localhost:5432/recall
# RECALL_EMBEDDER=fastembed
# Keep .env and token files outside this corpus-only root.
# RECALL_INDEX_ROOT=/srv/recall/corpus
# RECALL_TENANT=default
# RECALL_TRUST_MODE=development

# MCP transport and authentication. See docs/AUTH.md.
# RECALL_TRANSPORT=stdio
# RECALL_AUTH_TOKENS_FILE=/etc/recall/tokens.json
# RECALL_AUTH_ISSUER_URL=https://recall.example.com
# RECALL_AUTH_RESOURCE_URL=https://recall.example.com
# RECALL_OIDC_ISSUER=https://idp.example.com
# RECALL_OIDC_AUDIENCE=recall-prod
# RECALL_OIDC_TENANTS=acme,globex
# RECALL_OIDC_ALGORITHMS=RS256,ES256
# RECALL_OIDC_SUBJECT_TENANTS=alice@corp:acme,svc-etl:globex
# RECALL_OIDC_TRUST_TENANT_CLAIM=1
# Static auth is for development or staged cutovers. Production refuses static tokens.
# RECALL_AUTH_MODE=static

# Abuse bounds. Each rate can also be set to off. See docs/SECURITY_MODEL.md.
# RECALL_INDEX_MAX_FILES=2000
# RECALL_INDEX_MAX_BYTES=20000000
# RECALL_RATE_READ_PER_MIN=120
# RECALL_RATE_WRITE_PER_MIN=20
# RECALL_RATE_FORGET_PER_MIN=10
# RECALL_INDEX_BYTES_PER_HOUR=209715200

# Schema DDL
# RECALL_SCHEMA_LOCK_TIMEOUT_MS=5000

# Embedding artifact identity
RECALL_EMBED_PROFILE=
RECALL_MODEL_CACHE=
RECALL_MODEL_SHA256=
RECALL_QWEN_MODEL_PATH=

# Retrieval profile and admission control
RECALL_RETRIEVAL_PROFILE=
# RECALL_SEARCH_CONCURRENCY=
# RECALL_SEARCH_QUEUE=

# Quality profile reranker
RECALL_RERANK_THREADS=1
RECALL_RERANK_PATH=
RECALL_RERANK_SHA256=

# Candidate shadow artifacts
RECALL_SHADOW_MODEL_CACHE=
RECALL_SHADOW_MODEL_SHA256=
RECALL_SHADOW_QWEN_MODEL_PATH=

# Enterprise generation routing
RECALL_ENTERPRISE_CONTROL_PLANE=0

# Truth extraction over the corpus. Off unless RECALL_TRUTH_EXTRACTION is set to a true value.
# RECALL_TRUTH_EXTRACTION=1
# RECALL_TRUTH_EXTRACTION_ENGINE=deterministic
# RECALL_EXTRACTION_MODEL=anthropic/claude-sonnet-4.5
# RECALL_EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
# Required for the openai extraction engine.
# RECALL_EXTRACTION_API_KEY=
# RECALL_EXTRACTION_TIMEOUT=60
# RECALL_EXTRACTION_REVISION=unpinned

# Optional reasoning arm. Off unless RECALL_REASONING=1. The base URL identifies the provider;
# any OpenAI compatible endpoint works, including a local server such as Ollama.
# RECALL_REASONING=0
# RECALL_REASONING_MODEL=deepseek/deepseek-chat
# RECALL_REASONING_BASE_URL=https://openrouter.ai/api/v1
# RECALL_REASONING_API_KEY=
