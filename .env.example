# Copy to .env for local use. Full explanations live in docs/ENVIRONMENT.md.
# Keep .env private. It is gitignored and read only by local entry points via recall/_env.py.

# Optional cloud embedders. Local FastEmbed workflows do not need a key.
VOYAGE_API_KEY=
OPENROUTER_API_KEY=

# Core runtime
# RECALL_ENV=development
# RECALL_SERVING_DSN=postgresql://recall_server:...@localhost:5432/recall
# RECALL_MIGRATION_DSN=postgresql://recall_migrator:...@localhost:5432/recall
# RECALL_DSN=postgresql://recall:recall@localhost:5432/recall
# RECALL_EMBEDDER=fastembed
# Coding options:
#   RECALL_EMBEDDER=gemini-embedding-2
#   RECALL_EMBED_DIMENSIONS=1536
#   RECALL_EMBEDDER=sfr-code
#   RECALL_ACCEPT_RESEARCH_MODEL_LICENSE=1
#   RECALL_ACCEPT_REMOTE_MODEL_CODE=1
# Keep .env and token files outside this corpus-only root.
# RECALL_INDEX_ROOT=/srv/recall/corpus
# RECALL_INDEX_BATCH_CHUNKS=64                 # chunks per embedding batch; lower this if the
#                                              # local embedder runs out of memory
# RECALL_TENANT=default
# RECALL_TABLE=chunks                        # the chunk table the MCP server opens. `recall
#                                            # quickstart` writes to `quickstart_chunks`, so a
#                                            # server left on the default answers that corpus with
#                                            # zero hits and NO error. Legacy store only: refused
#                                            # under RECALL_ENV=production.
# RECALL_TRUST_MODE=development
# Retrieval reasoning is off unless explicitly enabled. Use a low-cost expansion model only.
# RECALL_REASONING_EXPANSION=0
# RECALL_REASONING_EXPANSION_MODEL=openai/gpt-5-nano
# RECALL_REASONING_EXPANSION_API_KEY=
# RECALL_REASONING_EXPANSION_BASE_URL=https://openrouter.ai/api/v1
# RECALL_REASONING_EXPANSION_TIMEOUT=30
# The three above are the preferred spellings and are what the resolver names in its errors.
# RECALL_REASONING_MODEL=                  # legacy model id used by older setup files
# The bare RECALL_REASONING_API_KEY, RECALL_REASONING_BASE_URL and RECALL_REASONING_TIMEOUT
# (spelled in full so an operator carrying an older config can find them here) are read as legacy
# fallbacks, and are shared with other reasoning arms, so prefer the infixed names.
# RECALL_REASONING_EXPANSION_COST_PER_1K_TOKENS=
# RECALL_REASONING_EXPANSION_EFFORT=minimal
# RECALL_REASONING_EXPANSION_REVISION=unpinned
# Optional answer provider for recall_reasoning_query, off unless explicitly enabled. With it off
# the tool abstains with no_answer_provider. See docs/REASONING_API.md.
# RECALL_REASONING_ANSWER_ENABLED=0
# RECALL_REASONING_ANSWER_PROVIDER=ollama # ollama | openai; ollama is the default
# RECALL_REASONING_ANSWER_MODEL=          # REQUIRED when ANSWER_ENABLED=1, no default
# RECALL_REASONING_ANSWER_BASE_URL=       # empty picks the backend's default:
#                                         # http://127.0.0.1:11434/v1 for ollama,
#                                         # https://openrouter.ai/api/v1 for openai
# RECALL_REASONING_ANSWER_TIMEOUT=60
# RECALL_REASONING_ANSWER_MAX_TOKENS=512
# RECALL_REASONING_ANSWER_REVISION=unpinned
# RECALL_REASONING_ANSWER_MAX_CALLS_PER_MIN=30  # ceiling on PAID answer calls, per process. Set
#                                         # to the word `off` to remove it, never to 0. Applies to
#                                         # both backends and to the CLI. This is the only thing
#                                         # bounding spend: the MCP read budget is per tenant and
#                                         # does not exist at all on stdio.
# RECALL_REASONING_ANSWER_THINKING=0      # Ollama only; refused with PROVIDER=openai
# PROVIDER=openai talks to any OpenAI-compatible /chat/completions endpoint and needs the openai
# extra. The ollama backend cannot reach one by base URL alone: it rewrites the path to
# <base>/api/chat and sends no Authorization header.
# RECALL_REASONING_ANSWER_API_KEY=        # REQUIRED for openai. The bare RECALL_REASONING_API_KEY
#                                         # is accepted as a LEGACY fallback for hand-written or
#                                         # pre-0.11 files; `recall setup` does NOT write it, so a
#                                         # wizard-configured install must set this one.
# RECALL_REASONING_ANSWER_COST_PER_1K_TOKENS=  # optional; unset records a NULL cost rather than
#                                         # claiming the hosted call was free. Per THOUSAND
#                                         # tokens: OpenRouter publishes per MILLION, and a
#                                         # pasted per-million figure is refused. REFUSED with
#                                         # PROVIDER=ollama, where inference is local and the
#                                         # recorded cost is always 0.0.
# For PROVIDER=openai the bare legacy RECALL_REASONING_BASE_URL and RECALL_REASONING_TIMEOUT are
# read as fallbacks too, so a pre-0.11 config keeps its own gateway instead of silently acquiring
# the OpenRouter default while keeping its key. A non-loopback base URL must be https, because
# the API key is sent with every request.

# MCP transport and authentication. See docs/AUTH.md.
# RECALL_TRANSPORT=stdio
# RECALL_MCP_STATELESS=1                       # streamable-http only; defaults to 1 for HTTP
#                                              # transports, set 0 when session state is required
# RECALL_AUTH_TOKENS_FILE=/etc/recall/tokens.json
# RECALL_AUTH_ISSUER_URL=https://recall.example.com
# RECALL_AUTH_RESOURCE_URL=https://recall.example.com
# RECALL_OIDC_ISSUER=https://idp.example.com
# RECALL_OIDC_AUDIENCE=recall-prod
# RECALL_OIDC_TENANTS=acme,globex
# RECALL_OIDC_ALGORITHMS=RS256,ES256
# RECALL_OIDC_SUBJECT_TENANTS=alice@corp:acme,svc-etl:globex
# RECALL_OIDC_TRUST_TENANT_CLAIM=1
# Static auth is for development or staged cutovers. Production refuses static tokens.
# RECALL_AUTH_MODE=static

# Abuse bounds. Each rate can also be set to off. See docs/SECURITY_MODEL.md.
# RECALL_INDEX_MAX_FILES=2000
# RECALL_INDEX_MAX_BYTES=20000000
# RECALL_RATE_READ_PER_MIN=120
# RECALL_RATE_WRITE_PER_MIN=20
# RECALL_RATE_FORGET_PER_MIN=10
# RECALL_RATE_ADMIN_PER_MIN=10
# RECALL_RATE_AUTH_FAILURES_PER_MIN=60   # process-global OIDC pre-auth failure throttle; `off` to disable
# RECALL_INDEX_BYTES_PER_HOUR=209715200

# Optional presentation localization. Disabled by default. Canonical retrieval and evidence are
# never replaced. Use HTTPS for a deployed endpoint; HTTP is accepted only for loopback unless the
# explicit insecure override is set. See docs/ENVIRONMENT.md.
# RECALL_TRANSLATION_ENABLED=0
# RECALL_TRANSLATION_ENDPOINT=https://api.translate.zvo.cn/translate.json
# RECALL_TRANSLATION_TIMEOUT_SECONDS=5
# RECALL_TRANSLATION_MAX_BATCH=32
# RECALL_TRANSLATION_MAX_TEXT_CHARS=20000
# RECALL_TRANSLATION_MAX_RESPONSE_BYTES=2000000
# RECALL_TRANSLATION_ALLOW_HTTP=0

# Schema DDL
# RECALL_SCHEMA_LOCK_TIMEOUT_MS=5000

# Embedding artifact identity
RECALL_EMBED_PROFILE=
RECALL_MODEL_CACHE=
RECALL_MODEL_SHA256=
RECALL_QWEN_MODEL_PATH=

# Retrieval profile and admission control
RECALL_RETRIEVAL_PROFILE=
# shadow keeps the preregistered routing decision observable without changing retrieval;
# active opts into bounded fast or quality routing after its promotion gates pass.
RECALL_ROUTING_MODE=shadow
# RECALL_SEARCH_CONCURRENCY=
# RECALL_SEARCH_QUEUE=

# Quality profile reranker
RECALL_RERANK_THREADS=1
RECALL_RERANK_PATH=
RECALL_RERANK_SHA256=
# Code reranker profile:
#   RECALL_RETRIEVAL_PROFILE=code
#   RECALL_RERANK_MODEL=coreb-code
#   RECALL_RERANK_BATCH_SIZE=4
#   RECALL_ACCEPT_REMOTE_MODEL_CODE=1

# Candidate shadow artifacts
RECALL_SHADOW_MODEL_CACHE=
RECALL_SHADOW_MODEL_SHA256=
RECALL_SHADOW_QWEN_MODEL_PATH=

# Enterprise generation routing
RECALL_ENTERPRISE_CONTROL_PLANE=0
