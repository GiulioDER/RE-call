{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GiulioDER/re-call",
  "title": "RE-call MCP Memory Server",
  "description": "Trustworthy Postgres plus pgvector memory for AI agents.",
  "websiteUrl": "https://github.com/GiulioDER/RE-call/blob/master/docs/USING_WITH_CLAUDE.md",
  "repository": {
    "url": "https://github.com/GiulioDER/RE-call",
    "source": "github"
  },
  "version": "0.9.7",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "recall-rag",
      "version": "0.9.7",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "recall-rag[mcp,fastembed]==0.9.7"
        },
        {
          "type": "positional",
          "value": "recall-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RECALL_SERVING_DSN",
          "description": "PostgreSQL serving DSN for the RE-call memory store.",
          "format": "string",
          "isRequired": true,
          "isSecret": true,
          "placeholder": "postgresql://recall:recall@localhost:5432/recall"
        },
        {
          "name": "RECALL_TENANT",
          "description": "Tenant id served by this local stdio server.",
          "format": "string",
          "isRequired": false,
          "default": "default"
        },
        {
          "name": "RECALL_TRUST_MODE",
          "description": "Set to development only for local uncalibrated corpora.",
          "format": "string",
          "isRequired": false,
          "placeholder": "development"
        }
      ]
    }
  ]
}
