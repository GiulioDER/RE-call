{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GiulioDER/RE-call/blob/master/recall/schemas/recall_record.v1.json",
  "title": "recall_record v1",
  "description": "One audit record (bug, false positive, lesson or retraction), carried as the one-line JSON value of a memo's recall_record front matter key. RE-call returns it exactly as authored. See docs/AUDIT_MEMORY_DESIGN.md.",
  "oneOf": [
    {
      "title": "bug",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "id",
        "project",
        "repo",
        "date",
        "bug_id",
        "tier",
        "files",
        "finding_id",
        "category",
        "severity",
        "auditor",
        "fix_commit",
        "run_id",
        "evidence",
        "sources",
        "summary",
        "supersedes",
        "ordinal",
        "anchors",
        "caused_by"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "const": "bug"
        },
        "bug_id": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "proved",
            "historical"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "auditor": {
          "type": [
            "string",
            "null"
          ]
        },
        "fix_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmed_l25",
            "fixed",
            "l6_approved",
            "red_proof"
          ],
          "properties": {
            "confirmed_l25": {
              "enum": [
                "evidenced",
                "claimed",
                "absent",
                "not_required"
              ]
            },
            "fixed": {
              "enum": [
                "evidenced",
                "claimed",
                "absent",
                "not_required"
              ]
            },
            "l6_approved": {
              "enum": [
                "evidenced",
                "claimed",
                "absent",
                "not_required"
              ]
            },
            "red_proof": {
              "enum": [
                "evidenced",
                "claimed",
                "absent",
                "not_required"
              ]
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "symbol",
              "code_sha"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\]+$"
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "code_sha": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "caused_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    {
      "title": "false_positive",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "id",
        "project",
        "repo",
        "date",
        "run_id",
        "finding_id",
        "category",
        "severity",
        "priority",
        "high_stakes",
        "auditor",
        "claim",
        "fp_reason",
        "evidence_refs",
        "verify_source",
        "anchors"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "const": "false_positive"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "high_stakes": {
          "type": "boolean"
        },
        "auditor": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "fp_reason": {
          "const": "not_real"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^.+:[0-9]+$"
          }
        },
        "verify_source": {
          "enum": [
            "llm",
            "tool"
          ]
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "symbol",
              "code_sha"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\]+$"
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "code_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "title": "lesson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "id",
        "project",
        "repo",
        "date",
        "rule",
        "pattern",
        "anchors",
        "members",
        "accepted_by",
        "accepted_at"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "const": "lesson"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "symbol",
              "code_sha"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\]+$"
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "code_sha": {
                "type": "null"
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "accepted_by": {
          "type": "string",
          "minLength": 1
        },
        "accepted_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    {
      "title": "retraction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "kind",
        "id",
        "project",
        "repo",
        "date",
        "target_id",
        "reason",
        "retracted_by"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "kind": {
          "enum": [
            "false_positive_retraction",
            "lesson_retraction"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "retracted_by": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
