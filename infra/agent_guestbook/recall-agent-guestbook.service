[Unit]
Description=RE-call voluntary agent guestbook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/recall-agent-guestbook
ExecStart=/usr/bin/python3 %h/recall-agent-guestbook/agent_guestbook_server.py --host 127.0.0.1 --port 8789 --database %h/.local/share/recall-agent-guestbook/guestbook.sqlite3
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/recall-agent-guestbook
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=64
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=default.target
