# Install as /etc/recall-aml/hosted.env with owner root:recall-aml and mode 0640.
# Supplied when the AML admission run opens. The service must not start before replacement.
RECALL_AML_DATABASE_URL=
RECALL_AML_API_KEY=
# The API key is scoped to this one hosted user. Never leave this unset. For an evaluation
# platform that sends a different user_id per sample (the official AML run), set it to *.
RECALL_AML_AUTHORIZED_USER_ID=
RECALL_AML_GIT_COMMIT=CHANGE_ME
RECALL_AML_TABLE=recall_aml_chunks
RECALL_AML_GENERATION=aml-code4-exact-bm25-v1
RECALL_AML_HOST=127.0.0.1
RECALL_AML_PORT=18004
RECALL_AML_ADD_CONCURRENCY=3
RECALL_AML_SEARCH_CONCURRENCY=3
# Answer an Add still running after this many seconds 503 pending and let its resend join it.
# 0 or unset is off (answer only when finished); otherwise 10 to 95, under the tunnel's ~100 s cut.
RECALL_AML_ADD_RESPONSE_BUDGET_SECONDS=0
# Queue a user's mutations (Add, delete, sparse backfill) first in, first out for up to this many
# seconds, instead of failing a same-user Add at the 25 s lock timeout. 0 or unset is off;
# otherwise 25 to 1800, and only with the response budget above set (at most 24 x (budget + 1))
# and RECALL_AML_ADD_CONCURRENCY of at least 2.
RECALL_AML_TENANT_LOCK_WAIT_SECONDS=0
# Optional forget suppression: choose off, drop, stub, or annotate before the first Add.
# The ledger records forget requests only while suppression is enabled.
# RECALL_AML_FORGET=off
# Gate choices: route (all current variants' default, code route exempt) or ledger (all routes).
# Active suppression with RECALL_AML_ROUTE_GATES=data requires ledger. The gate alone has no
# effect while forget is off. See docs/RECALL_HOSTED_INTEGRATION.md for code-preservation rules.
# RECALL_AML_FORGET_GATE=route
RECALL_AML_CONTEXT_CHARS=7000
RECALL_AML_VARIANT=C6_code4_exact_bm25
# Bind the existing shared lock here through the required systemd drop-in.
# See docs/RECALL_HOSTED_INTEGRATION.md for provisioning and permissions.
RECALL_AML_EMBED_LOCK_PATH=/run/recall-aml/embed.lock
OPENROUTER_API_KEY=CHANGE_ME
VOYAGE_API_KEY=CHANGE_ME
