# Install as /etc/recall-aml/hosted.env with owner root:recall-aml and mode 0640.
RECALL_AML_DATABASE_URL=postgresql://recall_aml_serving:CHANGE_ME@127.0.0.1:5432/recall_aml
RECALL_AML_API_KEY=CHANGE_ME
RECALL_AML_GIT_COMMIT=CHANGE_ME
RECALL_AML_TABLE=recall_aml_chunks
RECALL_AML_GENERATION=aml-hosted-v1
RECALL_AML_HOST=127.0.0.1
RECALL_AML_PORT=18004
RECALL_AML_ADD_CONCURRENCY=16
RECALL_AML_SEARCH_CONCURRENCY=16
RECALL_AML_CONTEXT_CHARS=7000
OPENAI_API_KEY=CHANGE_ME
VOYAGE_API_KEY=CHANGE_ME
